#!/usr/bin/env python3
"""
unsign — does authentication survive the hop?

Point it at a protocol and the relay, bridge or gateway that protocol runs
through, and it answers one question: if a sender appends authentication to a
message, does the receiver still have it?

Often the answer is no, and nothing anywhere reports a problem. The relay parses
the message, re-emits it from the fields it parsed, and any bytes outside the
protocol's declared boundary are simply not re-emitted. No rule is broken. The
relay is conformant. The receiver gets a well-formed command with the
authentication gone and no way to tell it was ever there.

That is the failure this tool detects. It needs no attacker.

Usage:

  unsign                     list what can be tested
  unsign mavlink             MAVLink v2 through a MAVLink-aware relay
  unsign ros2                ROS2 / DDS through a bridge

Anything after the protocol name is passed to that adapter:

  unsign mavlink --real-relay
  unsign ros2 --simulate
  unsign mavlink --help

Exit status is 0 when the run completes, 1 when it could not.

Each adapter is also runnable on its own (tools/unsign_mavlink.py,
tools/unsign_ros2.py); this dispatcher exists so the whole thing has one name.

Part of CleitonQ — github.com/cleitonaugusto/CleitonQ
"""

import os
import runpy
import sys

# Each entry: script, one-line description, the framing boundary, and the
# C1-C4 verdicts for that protocol. The four conditions are the decision
# procedure for this class; having them here makes the procedure executable
# rather than only prose, which is the point of `unsign --conditions`.
#
#   C1  boundary-delimited framing (a length field or a schema)
#   C2  authentication placed outside what that boundary counts
#   C3  a parse-then-reserialize intermediary on the path
#   C4  no raw-octet integrity at the receiver
#
# All four holding is what makes a protocol-and-relay pair strippable. A
# verdict here is a claim about the pair we measured, not about every
# deployment of that protocol: see each adapter's own output for the caveats,
# and note that mqtt is the one that does not answer yes to all four.
ADAPTERS = {
    "mavlink": (
        "unsign_mavlink.py",
        "MAVLink v2 — authentication appended after the frame CRC, through a "
        "MAVLink-aware relay (MAVProxy, mavlink-router).",
        "STX + 8-bit LEN field (self-delimiting frame)",
        (True, True, True, True),
        True,   # measured: authenticator does not reach the receiver
    ),
    "ros2": (
        "unsign_ros2.py",
        "ROS2 / DDS — authentication appended past the CDR payload, through "
        "ros1_bridge or a Fast DDS / CycloneDDS bridge.",
        "CDR type schema (4-byte encapsulation header + typed fields)",
        (True, True, True, True),
        True,   # measured: authenticator does not reach the receiver
    ),
    "can": (
        "unsign_can.py",
        "CAN / AUTOSAR — authentication appended past the ISO-TP declared "
        "length or past the UDS PDU, through a SecOC-unaware gateway.",
        "ISO-TP FirstFrame length, and the application PDU definition",
        (True, True, True, True),
        True,   # measured against the Linux kernel ISO-TP reassembler on vcan
    ),
    "someip": (
        "unsign_someip.py",
        "SOME/IP — authentication appended past the 32-bit Length, through a "
        "service gateway that rebuilds the message from parsed fields.",
        "32-bit Length field (Request ID through payload)",
        (True, True, True, True),
        True,   # measured on vsomeip 3.7.0, three runs
    ),
    "mqtt": (
        "unsign_mqtt.py",
        "MQTT — authentication in a v5 User Property, through a broker "
        "bridging to MQTT 3.1.1. Fails differently than the others.",
        "Remaining Length, plus the version's property set",
        (True, False, True, True),
        True,   # measured against mosquitto 2.1.2: it does not reach a 3.1.1
                # subscriber, even though C2 as worded says it should be safe
    ),
    "transcoder": (
        "unsign_transcoder.py",
        "gRPC-JSON transcoding — authentication in a proto field the JSON "
        "schema does not name, through Envoy, grpc-gateway, ConnectRPC or "
        "Cloud Endpoints.",
        "the .proto schema (only named fields cross the JSON mapping)",
        (True, True, True, True),
        True,   # measured on Envoy 1.31.10, grpc-gateway 2.30.0, ConnectRPC
                # 1.20.0 and Cloud Endpoints/ESPv2; silent drop by default on all
    ),
}

HERE = os.path.dirname(os.path.abspath(__file__))


def usage():
    print(__doc__.strip().split("Usage:")[0].strip())
    print()
    print("Protocols:")
    print()
    width = max(len(name) for name in ADAPTERS)
    for name, (_, blurb, _b, _c, _m) in sorted(ADAPTERS.items()):
        first, rest = blurb.split(" — ", 1)
        print("  %-*s  %s" % (width, name, first))
        for line in _wrap(rest, 70):
            print("  %-*s  %s" % (width, "", line))
        print()
    print("Run 'unsign <protocol>' to test one, or 'unsign <protocol> --help'")
    print("for the options that protocol takes. 'unsign --conditions' prints the")
    print("C1-C4 verdict for each without running anything.")


def conditions():
    """Print the C1-C4 decision procedure applied to each adapter."""
    print("  C1  boundary-delimited framing (a length field or a schema)")
    print("  C2  authentication placed outside what that boundary counts")
    print("  C3  a parse-then-reserialize intermediary on the path")
    print("  C4  no raw-octet integrity at the receiver")
    print()
    print("  All four holding is what makes a protocol-and-relay pair")
    print("  strippable. These are verdicts for the pairs actually measured,")
    print("  not for every deployment of the protocol.")
    print()
    width = max(len(n) for n in ADAPTERS)
    for name, (_, _blurb, boundary, cond, measured) in sorted(ADAPTERS.items()):
        marks = "  ".join("C%d=%s" % (i + 1, "yes" if v else "no ")
                          for i, v in enumerate(cond))
        predicted = all(cond)
        verdict = "predicted %s, measured %s" % (
            "strippable" if predicted else "safe",
            "strippable" if measured else "safe")
        if predicted != measured:
            verdict += "   <- they disagree"
        print("  %-*s  %s" % (width, name, marks))
        print("  %-*s  %s" % (width, "", verdict))
        print("  %-*s  boundary: %s" % (width, "", boundary))
        print()
    print("  mqtt is where the procedure as originally worded breaks, and that")
    print("  is worth more than the cases it gets right. C2 says the")
    print("  authenticator has to sit outside what the boundary counts. An MQTT")
    print("  5 User Property sits INSIDE it, so C2 says safe -- and mosquitto")
    print("  2.1.2 strips it anyway on the way to a 3.1.1 subscriber, because")
    print("  3.1.1 has no property field to carry it. Measured, not argued:")
    print("  run 'unsign mqtt --broker HOST:PORT'.")
    print()
    print("  So the real condition is not about framing. It is:")
    print()
    print("      authentication carried in any field the intermediary is not")
    print("      obligated to reproduce on the far side")
    print()
    print("  Framing is the most common way that happens, not the only one.")
    print()


def _wrap(text, width):
    line, out = "", []
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = word
        else:
            line = word if not line else line + " " + word
    if line:
        out.append(line)
    return out


def main():
    argv = sys.argv[1:]

    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0

    if argv[0] in ("--conditions", "-c"):
        conditions()
        return 0

    protocol = argv[0]
    if protocol not in ADAPTERS:
        print("unsign: no adapter for %r" % protocol, file=sys.stderr)
        print("known protocols: %s" % ", ".join(sorted(ADAPTERS)), file=sys.stderr)
        print("run 'unsign' with no arguments for the full list", file=sys.stderr)
        return 1

    script = os.path.join(HERE, ADAPTERS[protocol][0])
    if not os.path.exists(script):
        print("unsign: adapter missing: %s" % script, file=sys.stderr)
        return 1

    # Hand the remaining arguments to the adapter as if it had been invoked
    # directly, so its own --help and flags keep working unchanged.
    sys.argv = [script] + argv[1:]
    try:
        runpy.run_path(script, run_name="__main__")
    except SystemExit as exc:
        return exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    return 0


if __name__ == "__main__":
    sys.exit(main())
